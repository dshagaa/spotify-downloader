# Copy to .env and adjust before `docker compose up -d`.
APP_PASSWORD=change-me-to-something-long

# Optional: leave empty to generate and persist a key under /data.
SECRET_KEY=

# UID/GID that own the data/ and downloads/ folders on the host.
PUID=1000
PGID=1000

TZ=UTC
WEB_PORT=8000

DEFAULT_AUDIO_FORMAT=m4a
DEFAULT_CONCURRENT=3
MAX_CONCURRENT=8

# Set to true when serving over HTTPS directly (or via a proxy that does
# not forward X-Forwarded-Proto).
COOKIE_SECURE=false
